# ---- Required ----
# Token from @BotFather
BOT_TOKEN=
# Your Telegram user ID(s), comma-separated (get it from @userinfobot)
ADMIN_IDS=

# ---- Store (can also be changed later in Admin Panel > Settings) ----
STORE_NAME=Premium Account Store
UPI_ID=yourname@upi
UPI_NAME=Your Name
SUPPORT_CONTACT=@your_support_username
MIN_DEPOSIT=50
REFERRAL_PERCENT=5
OTP_WINDOW_HOURS=24

# ---- Optional ----
DATABASE_PATH=store.db
CURRENCY=₹
# Channel/group ID for sale & deposit logs (bot must be admin there), e.g. -1001234567890
LOG_CHANNEL_ID=
# Time zone offset in minutes (330 = India)
TZ_OFFSET_MINUTES=330
PAYMENT_TIMEOUT_MIN=15
MAX_PENDING_DEPOSITS=3
RATE_LIMIT=15

# ---- Optional: auto "Get OTP" (from https://my.telegram.org) ----
API_ID=
API_HASH=
